# Local development: apps/server/.env. On the VPS the secrets live in /etc/after-office.env (root only, loaded by
# systemd) and the rest is set in deploy/after-office.service; see docs/deploy.md.
# Copy to .env, or run `bun run auth:setup` to generate the auth values.

# Port for the Hono server
OFFICE_PORT=8787

# Dashboard login (generated by `bun run auth:setup`; the argon2 hash is stored base64-encoded)
OFFICE_USER=admin
OFFICE_PASSWORD_HASH=b64:...
# 64 hex chars; changing it signs everyone out
SESSION_SECRET=
# Bearer token Claude Code hooks send to POST /hook
HOOK_TOKEN=

# Production: cookies are Secure (HTTPS only). Set to false only for plain-HTTP local testing.
# OFFICE_SECURE_COOKIE=true
# Behind Caddy/nginx: trust X-Forwarded-For for rate limiting.
# OFFICE_TRUST_PROXY=true

# Agent folders must be inside one of these folders (":"-separated). Default: the folder that contains this
# After Office checkout, plus $HOME.
# OFFICE_ROOT=/home/office/agents:/home/office/projects
# Where the folder picker opens (default: the After Office checkout, if it's inside a root)
# OFFICE_DEFAULT_DIR=/home/office/agents

# Office timezone: cron schedules, day/night and daily token totals (the dashboard can change it)
# OFFICE_TZ=Asia/Jakarta

# Listen address. Production (NODE_ENV=production) defaults to 127.0.0.1 behind Caddy.
# OFFICE_HOST=127.0.0.1
# Built dashboard served by this process (default ../web/dist, created by `bun run build`)
# OFFICE_WEB_DIST=/opt/after-office/apps/web/dist
# SQLite database folder (default apps/server/data)
# OFFICE_DATA_DIR=/opt/after-office/apps/server/data

# Restart agent sessions that die (default true)
# OFFICE_AUTO_RESTART=true
# Agents use your Claude subscription: ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN are removed from their environment.
# Set to true to let an API key through (billed per token instead).
# OFFICE_ALLOW_API_KEY=false
# Allow the bypassPermissions mode for agents (default false)
# OFFICE_ALLOW_BYPASS=false
# Where Claude Code sends hooks and the statusline (default http://127.0.0.1:$OFFICE_PORT)
# OFFICE_HOOK_BASE=http://127.0.0.1:8787
# Binaries, if not on PATH
# CLAUDE_BIN=/home/office/.local/bin/claude
# TMUX_BIN=/usr/bin/tmux

# Done tasks older than this many days are archived (kept in the DB, hidden from the task lists). Default 30.
# OFFICE_ARCHIVE_DAYS=30
# Daily SQLite backup (gzipped) to data/backups, newest 14 kept. OFFICE_BACKUP=false turns it off.
# OFFICE_BACKUP_DIR=/opt/after-office/apps/server/data/backups
# OFFICE_BACKUP_KEEP=14

# Push notifications: easiest in the dashboard (bell icon → Automation → Notifications). Set here, a channel wins over
# the dashboard's. Which events are sent is a dashboard setting.
# OFFICE_NTFY_URL=https://ntfy.sh/your-long-secret-topic
# OFFICE_NTFY_TOKEN=
# OFFICE_TELEGRAM_BOT_TOKEN=
# OFFICE_TELEGRAM_CHAT_ID=
# OFFICE_WEBHOOK_URL=
# Public address of the dashboard: the link in notifications, and the base of cron webhook URLs
# OFFICE_PUBLIC_URL=https://office.example.com

# Most agents the manager may have in the office when it hires with create_agent (you can still add more yourself)
# OFFICE_MAX_AGENTS=12

# Extra variables agent sessions may see (comma separated). Agents get an allowlisted environment: none of the
# secrets above. Example: SSH_AUTH_SOCK, so local agents can push with your SSH key.
# OFFICE_AGENT_ENV=SSH_AUTH_SOCK
# Where hired agents' folders go (inside OFFICE_ROOT)
# OFFICE_AGENTS_DIR=~/after-office
# Listen address. Default 127.0.0.1 (the proxy / Vite sit in front); set 0.0.0.0 only if you know why.
# OFFICE_HOST=127.0.0.1

# Which Claude Code config folder (and so which Claude account) the agents use, when this machine has several:
# the same as running `CLAUDE_CONFIG_DIR=~/.claude-work claude`. Unset: Claude Code's default, ~/.claude.
# Changing it restarts the agents with a fresh conversation (conversations live in the config folder).
# OFFICE_CLAUDE_CONFIG_DIR=~/.claude-work
